{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "installCommand": null,
  "outputDirectory": ".",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/imaging/xvr",
      "destination": "/imaging",
      "permanent": true
    },
    {
      "source": "/imaging/xvr/:path*",
      "destination": "/imaging",
      "permanent": true
    },
    {
      "source": "/3d",
      "destination": "/imaging",
      "permanent": true
    },
    {
      "source": "/3d/",
      "destination": "/imaging/",
      "permanent": true
    },
    {
      "source": "/3d/:path*",
      "destination": "/imaging/:path*",
      "permanent": true
    },
    {
      "source": "/3d/:path+/",
      "destination": "/imaging/:path+/",
      "permanent": true
    },
    {
      "source": "/study-track",
      "destination": "/imaging/study-track",
      "permanent": true
    },
    {
      "source": "/study-track/",
      "destination": "/imaging/study-track/",
      "permanent": true
    },
    {
      "source": "/study-track/:path*",
      "destination": "/imaging/study-track/:path*",
      "permanent": true
    },
    {
      "source": "/study-track/:path+/",
      "destination": "/imaging/study-track/:path+/",
      "permanent": true
    },
    {
      "source": "/tools/ssHelper",
      "destination": "/tools/ssHelper/",
      "permanent": true
    },
    {
      "source": "/tools/triageHelper",
      "destination": "/tools/triageHelper/",
      "permanent": true
    },
    {
      "source": "/research(.html)?",
      "destination": "/about/research",
      "permanent": true
    },
    {
      "source": "/stats(.html)?",
      "destination": "/about/stats",
      "permanent": true
    },
    {
      "source": "/teaching(.html)?",
      "destination": "/about/teaching",
      "permanent": true
    },
    {
      "source": "/contact(.html)?",
      "destination": "/about/contact",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/tools/ssHelper/",
      "destination": "https://sshelper-five.vercel.app/tools/ssHelper"
    },
    {
      "source": "/tools/ssHelper/:path*",
      "destination": "https://sshelper-five.vercel.app/tools/ssHelper/:path*"
    },
    {
      "source": "/tools/triageHelper/",
      "destination": "https://triagehelper.vercel.app/index.html"
    },
    {
      "source": "/tools/triageHelper/:path*",
      "destination": "https://triagehelper.vercel.app/:path*"
    }
  ]
}
